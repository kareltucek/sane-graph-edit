digraph g {
  // what the controllers of a headset do (`--vr`); its help node leads to the help of the editor, as that one's leads here
  root [label="# VR controls\n\nTrigger: the left button\nGrip: the right button\n\nClick: let go with the controller still\n(less than 3 cm, 6°), within 0.3 s\n(the right trigger: no time limit)\nHold: else\n\nArrow keys, one node selected:\nthe node beside it, as you see them"; pos="0,0!"; "content-type"="markdown"];
  right [label="Right controller"; pos="-420,0!"; fillcolor="#C9DAF8"];
  left [label="Left controller"; pos="420,0!"; fillcolor="#FCE5CD"];
  rTrigger [label="# Trigger\n\n- click: select\n  - explore mode: unfold\n  - a terminal node selected: go into its shell\n  - on no node: a new one there, as deep as the node\n    nearest to the ray (a terminal if all are)\n- hold on a node: drag it\n  - explore mode: as Shift + drag, the others make way\n  - a thumbstick: further / nearer\n  - on the walls: where the ray meets one\n- hold on a corner of a selected node of its own size\n  (or just outside it, within 1.2°): resize it"; pos="-820,-260!"; "content-type"="markdown"];
  rGrip [label="# Grip\n\n- click: deselect\n  - explore mode: fold\n- hold on a node: it goes to where a node was last\n  taken in hand (clicked, dragged, turned around, held)"; pos="-820,0!"; "content-type"="markdown"];
  rStick [label="# Thumbsticks (both)\n\nforward / back:\n- a node dragged: it further / nearer\n- the graph in the left grip: it further / nearer\n- flying: on in / back out\n- a terminal gone into (a node being edited):\n  its text bigger / smaller\n- else: zoom in / out\n\naside: turn the graph\n\naround the node the ray is on, or the nearest to it\n\nA, B: nothing"; pos="-820,260!"; "content-type"="markdown"];
  lTrigger [label="# Trigger\n\n- click on a node with links: follow its link\n  - several links: a menu, the next click picks\n- hold: fly, in the room, never turned; across, the\n  graph goes with the hand; in and out the other way,\n  as fast as the hand is from where it was pressed,\n  times how hard"; pos="820,-260!"; "content-type"="markdown"];
  lGrip [label="# Grip\n\n- click: back (Ctrl+O)\n- hold: the graph in the hand: it goes and turns\n  with it (only about the upright), in and out\n  4 times as far"; pos="820,0!"; "content-type"="markdown"];
  lButtons [label="# Buttons\n\n- X: explore mode on / off\n- X twice: scan the room anew\n- Y: the graph on the walls or in space\n  (explore mode; the status line says which)\n- Y held: o, the springs, until let go\n- thumbstick: as the right one"; pos="820,260!"; "content-type"="markdown"];
  help [label="help\n(press gf)"; pos="0,-220!"; link="sge:help"; fillcolor="#F6EFC4"];
  root -> right;
  root -> left;
  right -> rTrigger;
  right -> rGrip;
  right -> rStick;
  left -> lTrigger;
  left -> lGrip;
  left -> lButtons;
  root -> help;
}
