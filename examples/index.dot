digraph examples {
  // the way around the examples and the documentation: select a node and press gf, Ctrl+O goes back
  index [label="Examples\n\nselect a node, gf follows it,\nCtrl+O goes back"; pos="0,0!"; fontsize="15.6"];
  simple [label="simple.dot\ntwo nodes and an edge"; pos="-300,150!"; link="simple.dot"; fillcolor="#F6EFC4"];
  marked [label="marked.dot\npersistent marks: 'A, 'B"; pos="0,150!"; link="marked.dot"; fillcolor="#F6EFC4"];
  cube [label="cube.dot\ndepth; :set 3d and the middle button turn it"; pos="350,150!"; link="cube.dot"; fillcolor="#F6EFC4"];
  help [label="help\nkeys and commands\n(press gf)"; pos="-300,-150!"; link="sge:help"; fillcolor="#F6EFC4"];
  readme [label="README.md\nthe manual"; pos="0,-150!"; link="../README.md:1-9999"; fillcolor="#F6EFC4"];
  format [label="file-format.md\nwhat a file holds"; pos="300,-150!"; link="../docs/file-format.md:1-9999"; fillcolor="#F6EFC4"];
  index -> simple;
  index -> marked;
  index -> cube;
  index -> help;
  index -> readme;
  index -> format;
}
