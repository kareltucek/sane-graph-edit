digraph g {
  // Each node holds a section of sections.txt, found by patterns as `git log -L` names lines; whole holds all of it.
  a [content-type="plain:sections.txt:/^Section A/,/^}/"; pos="0,0!"];
  b [content-type="plain:sections.txt:/^Section B/,/^}/"; pos="200,0!"];
  c [content-type="plain:sections.txt:/^Section C/,/^}/"; pos="400,0!"];
  whole [content-type="plain:sections.txt"; pos="200,300!"];
  // gf on these opens the same lines through a link
  "to-a" [label="link: section A"; pos="0,550!"; link="sections.txt:/^Section A/,/^}/"; fillcolor="#F6EFC4"];
  "to-b" [label="link: section B"; pos="200,550!"; link="sections.txt:/^Section B/,/^}/"; fillcolor="#F6EFC4"];
  "to-c" [label="link: section C"; pos="400,550!"; link="sections.txt:/^Section C/,/^}/"; fillcolor="#F6EFC4"];
  "to-whole" [label="link: whole file"; pos="600,550!"; link="sections.txt"; fillcolor="#F6EFC4"];
  // gf on it goes back to the list of examples
  index [label="examples"; pos="200,-150!"; link="index.dot:ranges"; fillcolor="#F6EFC4"];
  whole -> a;
  whole -> b;
  whole -> c;
}
